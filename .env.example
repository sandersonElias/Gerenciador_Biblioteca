# ==========================================
# Gerenciador Biblioteca - Environment Variables
# ==========================================
# Copie para .env.local (ou configure no provedor de deploy).
# Nunca versione segredos reais.

# Backend - execucao local
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gerenciador_biblioteca
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=senha123
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRATION=86400000
SHOW_SQL=false
SWAGGER_ENABLED=false

# CORS (separe multiplas origens por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin inicial (deixe vazio para nao criar)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dados de demonstracao
DEMO_DATA_ENABLED=false
DEMO_PASSWORD=

# E-mail (desativado por padrao; SMTP do Gmail)
EMAIL_ENABLED=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_REMETENTE=Biblioteca Monsa

# Render: use somente DATABASE_URL (o DatabaseConfig converte para JDBC)
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_API_TIMEOUT=10000
