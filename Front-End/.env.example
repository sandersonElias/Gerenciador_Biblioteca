# ==========================================
# Biblioteca Monsa - Environment Variables
# ==========================================

# API Configuration
# URL base da API backend
REACT_APP_API_URL=http://localhost:8080

# Timeout para requisições (em milissegundos)
REACT_APP_API_TIMEOUT=10000

# Authentication
# Chave para armazenar token no localStorage
REACT_APP_TOKEN_KEY=auth_token

# Chave para armazenar refresh token
REACT_APP_REFRESH_TOKEN_KEY=refresh_token

# Feature Flags
# Habilitar logs de debug
REACT_APP_ENABLE_DEBUG_LOGS=true

# ==========================================
# Configurações de Exemplo para Diferentes Ambientes
# ==========================================

# Desenvolvimento Local
# REACT_APP_API_BASE_URL=http://localhost:8080

# Produção (exemplo)
# REACT_APP_API_BASE_URL=https://api.bibliotecamonsa.com

# Staging (exemplo)
# REACT_APP_API_BASE_URL=https://api-staging.bibliotecamonsa.com